# Copy to .env.local for `npm run start:local`, or to .env for `npm start`.
# Every variable is described in docs/configuration.md.
#
# A line ending in `=` is a value you must supply. A commented line shows the default in force
# (empty: unset); uncomment it only to change it.

# --- Required: the app refuses to start without these ------------------------

# From your GitHub App's settings page.
APP_ID=
# The private key on one line: base64 < your-app.private-key.pem | tr -d '\n'
PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The "Webhook secret" set on the App. A mismatch makes every webhook answer HTTP 400.
WEBHOOK_SECRET=
# PostgreSQL. For the compose database: localhost and postgres.
DB_HOST=
DB_USER=
# Email domains that may enroll, comma-separated: acme.com,acme-labs.com
# Locally, the domain of a verified address on your own GitHub account.
ALLOWED_EMAIL_DOMAINS=

# --- Local development --------------------------------------------------------

# WEBHOOK_PROXY_URL=                # your smee.io channel. Never on a hosted instance

# --- Dashboard ----------------------------------------------------------------
# Off, and /dashboard answers 404, until SESSION_SECRET is set. See docs/dashboard.md.

# SESSION_SECRET=                   # 32 characters minimum, its own key: openssl rand -hex 32
# DASHBOARD_OPERATOR_IDS=           # GitHub account ids that also see the Operations tab: 583231,480938 (gh api users/<login> --jq .id)

# --- Database -----------------------------------------------------------------

# DB_PASSWORD=                      # required when NODE_ENV=production
# DB_NAME=postgres
# DB_PORT=5432                      # match POSTGRES_HOST_PORT if you moved the compose port
# DB_SSL=                           # default: true in production, false otherwise

# --- Runtime ------------------------------------------------------------------

# NODE_ENV=development              # set production on a hosted instance
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info                    # trace|debug|info|warn|error|fatal
# LOG_FORMAT=                       # json|pretty. Default: json in production, pretty otherwise
# APP_REVISION=                     # the build's commit SHA, echoed by GET /version
# OCTOKIT_HTTP_PROXY=               # proxy for GitHub API calls: http://proxy.example.com:8080
# GITHUB_APP_PUBLIC_URL=            # install URL override. Default: derived from the credentials

# --- Report and dashboard -----------------------------------------------------

# OWN_GITHUB_ORGS=                  # GitHub owners your company owns: acme,acme-labs
# GITLAB_API_HOSTS=gitlab.com       # GitLab hosts the manual-entry form may read from
# JOB_RUN_RETENTION_DAYS=7

# --- Scheduling: read docs/configuration.md#scheduling before changing --------

# EVENTS_CRON=                      # default: */5 * * * * in production, */1 * * * * otherwise
# EVENTS_CRON_POLL=*/5 * * * *
# REPOS_CRON=                       # default: 23 */2 * * * in production, */3 * * * * otherwise
# RECONCILE_CRON=                   # default: 7 * * * * in production, */10 * * * * otherwise
# SYNC_MIN_INTERVAL_MINUTES=15
# SYNC_MAX_INTERVAL_MINUTES=240
# POLL_MIN_INTERVAL_MINUTES=15
# POLL_MAX_INTERVAL_MINUTES=240
# REPO_REFRESH_INTERVAL_MINUTES=360
# SYNC_BATCH_SIZE=200
# POLL_BATCH_SIZE=200
# REPO_BATCH_SIZE=40
# CLAIM_LEASE_MINUTES=15
# MAX_ERROR_BACKOFF_MINUTES=360
# SYNC_DISABLE_AFTER_404=3
# SYNC_DISABLE_AFTER_FAILURES=50
# REPO_GONE_AFTER_404=3
